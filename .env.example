NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Required: JSON map of versioned 32-byte base64 PHI keys; generate a unique key per environment.
MEGAP_PHI_ENCRYPTION_KEYS=
MEGAP_PHI_ACTIVE_KEY_VERSION=v1
POSTGRES_ADMIN_PASSWORD=megap_admin_local_only
MEGAP_APP_PASSWORD=megap_app_local_only
DATABASE_URL=postgresql://megap_app:megap_app_local_only@localhost:5432/megap?schema=public
DIRECT_URL=postgresql://megap_admin:megap_admin_local_only@localhost:5432/megap?schema=public
REDIS_URL=redis://localhost:6379
TZ=Asia/Tehran
