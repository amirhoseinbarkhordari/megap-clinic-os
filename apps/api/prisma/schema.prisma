generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

model Tenant {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String               @db.VarChar(160)
  slug          String               @unique @db.VarChar(80)
  status        TenantStatus         @default(ACTIVE)
  timezone      String               @default("Asia/Tehran") @db.VarChar(64)
  currency      String               @default("IRR") @db.VarChar(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships   Membership[]
  branches      Branch[]
  roles         Role[]
  subscriptions TenantSubscription[]
  patients      Patient[]
  staff         Staff[]
  services      ClinicService[]
  appointments  Appointment[]

  @@map("tenants")
}

model User {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String?          @unique @db.VarChar(254)
  phone           String?          @unique @db.VarChar(32)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  displayName     String           @map("display_name") @db.VarChar(160)
  emailVerifiedAt DateTime?        @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime?        @map("phone_verified_at") @db.Timestamptz(6)
  disabledAt      DateTime?        @map("disabled_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships     Membership[]
  sessions        RefreshSession[]

  @@map("users")
}

model Membership {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  sessions  RefreshSession[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
  @@map("memberships")
}

model Role {
  id          String           @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  name        String           @db.VarChar(80)
  key         String           @db.VarChar(80)
  isSystem    Boolean          @default(false) @map("is_system")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]
  permissions RolePermission[]

  @@id([tenantId, id])
  @@unique([tenantId, key])
  @@map("roles")
}

model Permission {
  key         String           @id @db.VarChar(120)
  description String           @db.VarChar(240)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  tenantId      String     @map("tenant_id") @db.Uuid
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key") @db.VarChar(120)
  role          Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([tenantId, roleId, permissionKey])
  @@map("role_permissions")
}

model Branch {
  id           String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  name         String        @db.VarChar(160)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patients     Patient[]
  staff        Staff[]
  appointments Appointment[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@map("branches")
}

model TenantSubscription {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  planKey             String             @map("plan_key") @db.VarChar(60)
  status              SubscriptionStatus @default(TRIAL)
  currentPeriodStarts DateTime           @map("current_period_starts") @db.Timestamptz(6)
  currentPeriodEnds   DateTime           @map("current_period_ends") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("tenant_subscriptions")
}

model RefreshSession {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  tokenHash    String     @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_sessions")
}

model Patient {
  id           String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  branchId     String?       @map("branch_id") @db.Uuid
  fullName     String        @map("full_name") @db.VarChar(160)
  phone        String?       @db.VarChar(32)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch?       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  appointments Appointment[]

  @@id([tenantId, id])
  @@unique([tenantId, phone])
  @@index([tenantId, fullName])
  @@map("patients")
}

model Staff {
  id           String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  branchId     String?       @map("branch_id") @db.Uuid
  displayName  String        @map("display_name") @db.VarChar(160)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch?       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  appointments Appointment[]

  @@id([tenantId, id])
  @@index([tenantId, displayName])
  @@map("staff")
}

model ClinicService {
  id              String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  name            String        @db.VarChar(160)
  durationMinutes Int           @map("duration_minutes")
  priceRial       BigInt        @default(0) @map("price_rial")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointments    Appointment[]

  @@id([tenantId, id])
  @@index([tenantId, isActive, name])
  @@map("clinic_services")
}

model Appointment {
  id        String            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  branchId  String?           @map("branch_id") @db.Uuid
  patientId String            @map("patient_id") @db.Uuid
  staffId   String            @map("staff_id") @db.Uuid
  serviceId String            @map("service_id") @db.Uuid
  startsAt  DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime          @map("ends_at") @db.Timestamptz(6)
  status    AppointmentStatus @default(BOOKED)
  note      String?           @db.VarChar(500)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch    Branch?           @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  patient   Patient           @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  staff     Staff             @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  service   ClinicService     @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, startsAt])
  @@index([tenantId, patientId, startsAt])
  @@map("appointments")
}
