generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum EncounterStatus {
  OPEN
  CLOSED
}

enum ClinicalNoteType {
  GENERAL
  EXAMINATION
  TREATMENT
  ADDENDUM
}

enum ConsentKind {
  TREATMENT
  PRIVACY
  COMMUNICATION
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ONLINE
  OTHER
}

enum FinancialEntryKind {
  PAYMENT
  REFUND
  EXPENSE
}

enum FinancialDirection {
  INCOME
  OUTGOING
}

enum InventoryMovementKind {
  OPENING
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
}

model Tenant {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String               @db.VarChar(160)
  slug               String               @unique @db.VarChar(80)
  status             TenantStatus         @default(ACTIVE)
  timezone           String               @default("Asia/Tehran") @db.VarChar(64)
  currency           String               @default("IRR") @db.VarChar(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships        Membership[]
  branches           Branch[]
  roles              Role[]
  subscriptions      TenantSubscription[]
  patients           Patient[]
  staff              Staff[]
  services           ClinicService[]
  appointments       Appointment[]
  encounters         ClinicalEncounter[]
  clinicalNotes      ClinicalNote[]
  consents           PatientConsent[]
  auditEvents        AccessAudit[]
  invoices           Invoice[]
  invoiceLines       InvoiceLine[]
  financialEntries   FinancialEntry[]
  products           InventoryProduct[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]

  @@map("tenants")
}

model User {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String?          @unique @db.VarChar(254)
  phone           String?          @unique @db.VarChar(32)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  displayName     String           @map("display_name") @db.VarChar(160)
  emailVerifiedAt DateTime?        @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime?        @map("phone_verified_at") @db.Timestamptz(6)
  disabledAt      DateTime?        @map("disabled_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships     Membership[]
  sessions        RefreshSession[]

  @@map("users")
}

model Membership {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String              @map("tenant_id") @db.Uuid
  userId                String              @map("user_id") @db.Uuid
  roleId                String              @map("role_id") @db.Uuid
  status                MembershipStatus    @default(ACTIVE)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  role                  Role                @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  sessions              RefreshSession[]
  clinicalNotesAuthored ClinicalNote[]
  consentsRecorded      PatientConsent[]
  auditEvents           AccessAudit[]
  createdInvoices       Invoice[]
  financialEntries      FinancialEntry[]
  inventoryMovements    InventoryMovement[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
  @@map("memberships")
}

model Role {
  id          String           @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  name        String           @db.VarChar(80)
  key         String           @db.VarChar(80)
  isSystem    Boolean          @default(false) @map("is_system")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]
  permissions RolePermission[]

  @@id([tenantId, id])
  @@unique([tenantId, key])
  @@map("roles")
}

model Permission {
  key         String           @id @db.VarChar(120)
  description String           @db.VarChar(240)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  tenantId      String     @map("tenant_id") @db.Uuid
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key") @db.VarChar(120)
  role          Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([tenantId, roleId, permissionKey])
  @@map("role_permissions")
}

model Branch {
  id                 String              @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  name               String              @db.VarChar(160)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patients           Patient[]
  staff              Staff[]
  appointments       Appointment[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  financialEntries   FinancialEntry[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@map("branches")
}

model TenantSubscription {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  planKey             String             @map("plan_key") @db.VarChar(60)
  status              SubscriptionStatus @default(TRIAL)
  currentPeriodStarts DateTime           @map("current_period_starts") @db.Timestamptz(6)
  currentPeriodEnds   DateTime           @map("current_period_ends") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("tenant_subscriptions")
}

model RefreshSession {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  tokenHash    String     @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_sessions")
}

model Patient {
  id               String              @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  branchId         String?             @map("branch_id") @db.Uuid
  fullName         String              @map("full_name") @db.VarChar(160)
  phone            String?             @db.VarChar(32)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch           Branch?             @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  appointments     Appointment[]
  encounters       ClinicalEncounter[]
  consents         PatientConsent[]
  auditEvents      AccessAudit[]
  invoices         Invoice[]
  financialEntries FinancialEntry[]

  @@id([tenantId, id])
  @@unique([tenantId, phone])
  @@index([tenantId, fullName])
  @@map("patients")
}

model Staff {
  id           String              @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  branchId     String?             @map("branch_id") @db.Uuid
  displayName  String              @map("display_name") @db.VarChar(160)
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch?             @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  appointments Appointment[]
  encounters   ClinicalEncounter[]

  @@id([tenantId, id])
  @@index([tenantId, displayName])
  @@map("staff")
}

model ClinicService {
  id              String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  name            String        @db.VarChar(160)
  durationMinutes Int           @map("duration_minutes")
  priceRial       BigInt        @default(0) @map("price_rial")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointments    Appointment[]
  invoiceLines    InvoiceLine[]

  @@id([tenantId, id])
  @@index([tenantId, isActive, name])
  @@map("clinic_services")
}

model Appointment {
  id        String             @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  branchId  String?            @map("branch_id") @db.Uuid
  patientId String             @map("patient_id") @db.Uuid
  staffId   String             @map("staff_id") @db.Uuid
  serviceId String             @map("service_id") @db.Uuid
  startsAt  DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime           @map("ends_at") @db.Timestamptz(6)
  status    AppointmentStatus  @default(BOOKED)
  note      String?            @db.VarChar(500)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch    Branch?            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  patient   Patient            @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  staff     Staff              @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  service   ClinicService      @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  encounter ClinicalEncounter?
  invoice   Invoice?

  @@id([tenantId, id])
  @@unique([tenantId, id, patientId, staffId])
  @@index([tenantId, startsAt])
  @@index([tenantId, patientId, startsAt])
  @@map("appointments")
}

model Invoice {
  id                    String           @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String           @map("tenant_id") @db.Uuid
  patientId             String           @map("patient_id") @db.Uuid
  createdByMembershipId String           @map("created_by_membership_id") @db.Uuid
  appointmentId         String?          @map("appointment_id") @db.Uuid
  idempotencyKey        String           @map("idempotency_key") @db.VarChar(128)
  totalRial             BigInt           @map("total_rial")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient               Patient          @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  createdBy             Membership       @relation(fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)
  appointment           Appointment?     @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  lines                 InvoiceLine[]
  entries               FinancialEntry[]

  @@id([tenantId, id])
  @@unique([tenantId, appointmentId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, patientId, createdAt])
  @@map("invoices")
}

model InvoiceLine {
  id            String         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  invoiceId     String         @map("invoice_id") @db.Uuid
  serviceId     String?        @map("service_id") @db.Uuid
  description   String         @db.VarChar(240)
  quantity      Int
  unitPriceRial BigInt         @map("unit_price_rial")
  lineTotalRial BigInt         @map("line_total_rial")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice       Invoice        @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  service       ClinicService? @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, invoiceId])
  @@map("invoice_lines")
}

model FinancialEntry {
  id                    String             @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  patientId             String?            @map("patient_id") @db.Uuid
  invoiceId             String?            @map("invoice_id") @db.Uuid
  branchId              String?            @map("branch_id") @db.Uuid
  createdByMembershipId String             @map("created_by_membership_id") @db.Uuid
  kind                  FinancialEntryKind
  direction             FinancialDirection
  amountRial            BigInt             @map("amount_rial")
  currency              String             @default("IRR") @db.VarChar(3)
  paymentMethod         PaymentMethod?     @map("payment_method")
  idempotencyKey        String             @map("idempotency_key") @db.VarChar(128)
  reversesEntryId       String?            @map("reverses_entry_id") @db.Uuid
  memo                  String?            @db.VarChar(500)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient               Patient?           @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  invoice               Invoice?           @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  branch                Branch?            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  createdBy             Membership         @relation(fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)
  reverses              FinancialEntry?    @relation("FinancialReversal", fields: [tenantId, reversesEntryId], references: [tenantId, id], onDelete: Restrict)
  reverseEntries        FinancialEntry[]   @relation("FinancialReversal")

  @@id([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, reversesEntryId])
  @@index([tenantId, createdAt])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, invoiceId, createdAt])
  @@map("financial_entries")
}

model InventoryProduct {
  id           String              @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  sku          String?             @db.VarChar(80)
  name         String              @db.VarChar(160)
  category     String?             @db.VarChar(120)
  unit         String              @default("unit") @db.VarChar(24)
  reorderPoint Int                 @default(0) @map("reorder_point")
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  balances     InventoryBalance[]
  movements    InventoryMovement[]

  @@id([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId, isActive, name])
  @@map("inventory_products")
}

model InventoryBalance {
  tenantId       String           @map("tenant_id") @db.Uuid
  branchId       String           @map("branch_id") @db.Uuid
  productId      String           @map("product_id") @db.Uuid
  quantityOnHand Int              @default(0) @map("quantity_on_hand")
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch         Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  product        InventoryProduct @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, branchId, productId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id                    String                @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  branchId              String                @map("branch_id") @db.Uuid
  productId             String                @map("product_id") @db.Uuid
  createdByMembershipId String                @map("created_by_membership_id") @db.Uuid
  kind                  InventoryMovementKind
  quantityDelta         Int                   @map("quantity_delta")
  unitCostRial          BigInt?               @map("unit_cost_rial")
  idempotencyKey        String                @map("idempotency_key") @db.VarChar(128)
  note                  String?               @db.VarChar(500)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch                Branch                @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  product               InventoryProduct      @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  createdBy             Membership            @relation(fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, branchId, productId, createdAt])
  @@map("inventory_movements")
}

model ClinicalEncounter {
  id            String          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  patientId     String          @map("patient_id") @db.Uuid
  staffId       String          @map("staff_id") @db.Uuid
  appointmentId String?         @map("appointment_id") @db.Uuid
  status        EncounterStatus @default(OPEN)
  startedAt     DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime?       @map("ended_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient       Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  staff         Staff           @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  appointment   Appointment?    @relation(fields: [tenantId, appointmentId, patientId, staffId], references: [tenantId, id, patientId, staffId], onDelete: Restrict)
  notes         ClinicalNote[]

  @@id([tenantId, id])
  @@unique([tenantId, appointmentId])
  @@unique([tenantId, appointmentId, patientId, staffId])
  @@index([tenantId, patientId, startedAt])
  @@map("clinical_encounters")
}

model ClinicalNote {
  id                 String            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  encounterId        String            @map("encounter_id") @db.Uuid
  authorMembershipId String            @map("author_membership_id") @db.Uuid
  kind               ClinicalNoteType  @default(GENERAL)
  ciphertext         String            @db.Text
  nonce              String            @db.VarChar(24)
  authTag            String            @map("auth_tag") @db.VarChar(24)
  keyVersion         String            @map("key_version") @db.VarChar(32)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  encounter          ClinicalEncounter @relation(fields: [tenantId, encounterId], references: [tenantId, id], onDelete: Restrict)
  authorMembership   Membership        @relation(fields: [tenantId, authorMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, encounterId, createdAt])
  @@map("clinical_notes")
}

model PatientConsent {
  id                 String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  patientId          String      @map("patient_id") @db.Uuid
  recordedByMemberId String      @map("recorded_by_member_id") @db.Uuid
  kind               ConsentKind
  documentVersion    String      @map("document_version") @db.VarChar(80)
  grantedAt          DateTime    @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt          DateTime?   @map("revoked_at") @db.Timestamptz(6)
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient            Patient     @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  recordedBy         Membership  @relation(fields: [tenantId, recordedByMemberId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, patientId, kind, grantedAt])
  @@map("patient_consents")
}

model AccessAudit {
  id                String     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  patientId         String     @map("patient_id") @db.Uuid
  actorMembershipId String     @map("actor_membership_id") @db.Uuid
  action            String     @db.VarChar(80)
  resourceType      String     @map("resource_type") @db.VarChar(80)
  resourceId        String?    @map("resource_id") @db.Uuid
  occurredAt        DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(6)
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient           Patient    @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  actorMembership   Membership @relation(fields: [tenantId, actorMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, patientId, occurredAt])
  @@map("access_audit")
}
