CREATE ROLE megap_app LOGIN PASSWORD :'app_password' NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
GRANT CONNECT ON DATABASE megap TO megap_app;
GRANT USAGE ON SCHEMA public TO megap_app;
ALTER DEFAULT PRIVILEGES FOR ROLE megap_admin IN SCHEMA public
  GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO megap_app;
ALTER DEFAULT PRIVILEGES FOR ROLE megap_admin IN SCHEMA public
  GRANT USAGE, SELECT ON SEQUENCES TO megap_app;
