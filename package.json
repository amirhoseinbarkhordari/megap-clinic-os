{
  "name": "megap-clinic-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev",
