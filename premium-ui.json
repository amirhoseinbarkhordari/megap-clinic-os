    "Text input": "apps/web/src/components/text-field.tsx",
    "Password input": "apps/web/src/components/text-field.tsx",
    "Authentication form": "apps/web/src/components/auth-form.tsx",
    "Patient workspace": "apps/web/src/app/workspace/page.tsx",
    "Navigation": "apps/web/src/app/workspace/page.tsx",
    "Form": "apps/web/src/components/auth-form.tsx",
    "CRUD": "apps/web/src/app/workspace/page.tsx",
    "Async resilience": "apps/web/src/lib/auth-context.tsx",
    "Date": "native",
    "Select/Listbox": "native"
  },
  "requiredCommands": ["typecheck", "build", "premium"],
  "commands": {
    "typecheck": "pnpm typecheck",
    "build": "pnpm build",
    "premium": "pnpm verify:premium"
